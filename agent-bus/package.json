{
  "name": "roundhouse",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Roundhouse \u2014 per-repo foreman/worker coordination bus for Claude Code (stdio MCP server + provisioning CLI).",
  "bin": {
    "agent-bus": "dist/cli.js"
  },
  "scripts": {
    "start": "tsx src/server.ts",
    "dashboard": "node dist/server.js serve",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "check-types": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:watch": "vitest watch",
    "bundle": "node scripts/bundle.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.25.2",
    "zod": "4.3.5"
  },
  "devDependencies": {
    "@types/node": "^22.13.14",
    "esbuild": "^0.28.1",
    "tsx": "4.21.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.17"
  }
}
