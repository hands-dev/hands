{
  "name": "hands",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Hands — extra hands for your repo: per-repo expo/station coordination bus for Claude Code (stdio MCP server + provisioning CLI).",
  "bin": {
    "hands": "dist/cli.js"
  },
  "scripts": {
    "start": "tsx src/server.ts",
    "dashboard": "node dist/server.js serve",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "check-types": "tsc --noEmit && tsc -p dashboard --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:watch": "vitest watch",
    "bundle": "node scripts/bundle.mjs",
    "bundle:stamp": "node scripts/bundle.mjs --stamp",
    "publish-installer": "node scripts/publish-installer-blob.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.224",
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "qrcode-terminal": "^0.12.0",
    "zod": "4.3.5"
  },
  "devDependencies": {
    "@fontsource/archivo": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@tailwindcss/cli": "4.3.3",
    "@types/node": "^22.13.14",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vercel/blob": "^2.7.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "esbuild": "0.28.1",
    "marked": "^18.0.9",
    "radix-ui": "1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "2.15.4",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.21.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.17"
  }
}
