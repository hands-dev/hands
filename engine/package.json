{
  "name": "hands",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Hands \u2014 extra hands for your repo: per-repo expo/station coordination bus for Claude Code (stdio MCP server + provisioning CLI).",
  "bin": {
    "hands": "dist/cli.js"
  },
  "scripts": {
    "start": "tsx src/server.ts",
    "dashboard": "node dist/server.js serve",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "check-types": "tsc --noEmit && tsc -p dashboard --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:watch": "vitest watch",
    "bundle": "node scripts/bundle.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.25.2",
    "zod": "4.3.5"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.3",
    "@types/node": "^22.13.14",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "esbuild": "0.28.1",
    "radix-ui": "1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.21.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.17"
  }
}
