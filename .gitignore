node_modules/
# compiled TS output (the package builds it); plugin/dist bundles ARE committed
engine/dist/
*.log
# runtime message data — never commit (plaintext cross-worktree history)
*.db
*.db-shm
*.db-wal
*.notify
*.last-compact
*.last-utilization
# generated by `hands craft sync` / station provisioning (hands#81/#96) — regenerated from the
# craft's own book/mise/skill on every sync, never hand-edited, never committed. NOT relying on
# the user's global gitignore for this (hands#120 already burned us once that way with
# .claude/settings.local.json — a seeded/generated file that isn't repo-gitignored shows up as
# dirty and can silently break `git worktree remove`).
.claude/agents/craft-*.md
.claude/skills/craft-*/
